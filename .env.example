# DRIP environment. Copy to .env.local and fill in. Never commit real values.

# ── LLM (Anthropic). ONLY lib/llm.ts reads these. Server-side only. ──
ANTHROPIC_API_KEY=
# Optional model overrides (defaults from the spec)
LLM_PLAN_MODEL=claude-sonnet-4-6
LLM_WRITE_MODEL=claude-haiku-4-5
# Daily hard cap on paid calls (fails closed if the count can't be read)
LLM_DAILY_CALL_CAP=500
# Set to "mock" to run the whole app against deterministic canned output (no API key, no spend).
# Used by Playwright. Leave empty in real use.
LLM_MODE=
# The hard dead-prose gate (lib/copy/style.ts): a card carrying "plays a key role" or an eyebrow
# reading "overview" is rejected on arrival. Set to "off" to disable it without a deploy — if it
# ever fires more than about one card in twenty, the feed quietly gets thinner instead of louder.
DRIP_STYLE_GATE=

# ── Persistence (Supabase Postgres). Server-side only. ──
# When both are set, the Supabase store is used. When either is missing, DRIP
# falls back to a local JSON store in .data/ (dev/testing only) and logs a warning.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Force a store: "supabase" | "local" (default: auto by presence of the vars above)
DRIP_STORE=

# ── Door lock for a personal deployment (optional) ──
# Set this on a deployed instance and every page/API call requires the passphrase once per device.
# The cookie stores an HMAC, never the phrase. Leave empty locally — the gate is then a no-op.
DRIP_PASSPHRASE=

# ── Ingestion ──
# Optional: raises GitHub API rate limits for repo ingestion
GITHUB_TOKEN=
